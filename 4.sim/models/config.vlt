`verilator_config

// trng_bank SIM_ONLY ring model: its stage delays are >= 330 ps at runtime, never #0
lint_off -rule ZERODLY -file "*/ip.infra/trng/trng_bank.sv"
lint_off -rule PINCONNECTEMPTY
lint_off -rule PINMISSING
lint_off -rule DECLFILENAME
lint_off -rule GENUNNAMED
lint_off -rule IMPLICIT
lint_off -rule REALCVT
lint_off -rule EOFNEWLINE
lint_off -rule UNUSEDSIGNAL
lint_off -rule UNUSEDPARAM
lint_off -rule UNDRIVEN
lint_off -rule MULTIDRIVEN
lint_off -rule LATCH
lint_off -rule BLKSEQ
lint_off -rule SYNCASYNCNET
lint_off -rule MISINDENT
lint_off -rule VARHIDDEN
lint_off -rule UNOPTFLAT
lint_off -rule BLKANDNBLK
lint_off -rule WIDTHEXPAND
lint_off -rule WIDTHTRUNC
lint_off -rule PROCASSINIT
lint_off -rule DEFOVERRIDE
// Xilinx unisim simulation models: timing (specify) is not simulated
lint_off -rule SPECIFYIGN -file "*/models/no-change/*"
// and they write one variable from several plain always blocks (ODDR: both
// clock edges and the async set/reset): legal, and simulates as written
lint_off -rule MULTIDRIVENPROC -file "*/models/no-change/*"
// The flash model (behavioural, blocking): chip select and SCK edges each
// reset or shift the same bit state, from their own always blocks
lint_off -rule MULTIDRIVENPROC -file "*/models/spi_flash_model.sv"
// The generated CSR (PeakRDL-regblock): the cryptokey table ends at the top of
// the 14-bit address space (0x2000 + 0x1fff), so its "addr <= end" compare
// is always true (PeakRDL-regblock#225, tracked in #52: drop once fixed)
lint_off -rule CMPCONST -file "*/csr_build/generated-files/csr.sv"
